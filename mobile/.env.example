# Base URL of the existing Next.js backend (the same one `npm run dev` at the
# project root serves). A physical phone cannot reach your computer's
# `localhost`, so during development use your computer's LAN IP instead
# (find it with `ipconfig` on Windows or `ifconfig`/`ipconfig getifaddr en0`
# on Mac/Linux). The Expo dev client and your phone must be on the same
# Wi-Fi network.
#
# Development example:
EXPO_PUBLIC_API_URL=http://192.168.1.50:3000

# Production example:
# EXPO_PUBLIC_API_URL=https://your-production-domain.com
